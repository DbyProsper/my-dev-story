# Server-only values. Never use a VITE_ prefix for these secrets.
# Create a PRIVATE Vercel Blob store and connect it to this project.
BLOB_READ_WRITE_TOKEN=
# At least 16 characters. Set privately in Vercel; do not commit it.
ADMIN_PASSWORD=
# At least 32 random characters. Changing either secret invalidates all sessions.
ADMIN_SESSION_SECRET=

# Optional: local read-only preview of published content and uploaded media.
PUBLISHED_SITE_URL=

# Supabase is the default. The original Blob provider is available only if explicitly selected.
STORAGE_PROVIDER=supabase
SUPABASE_URL=https://yuyppcoectjbzvzjtchy.supabase.co
# Server-only secret from Supabase Settings > API Keys; never prefix with VITE_.
SUPABASE_SECRET_KEY=
SUPABASE_MEDIA_BUCKET=portfolio-media
