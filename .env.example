# Server-only values. Never use a VITE_ prefix for these secrets.
# Create a PRIVATE Vercel Blob store and connect it to this project.
BLOB_READ_WRITE_TOKEN=
# At least 16 characters. Set privately in Vercel; do not commit it.
ADMIN_PASSWORD=
# At least 32 random characters. Changing either secret invalidates all sessions.
ADMIN_SESSION_SECRET=
